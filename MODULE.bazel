"""
Theseed

The monorepo of Theseed

The include statements must not be consecutive, because buildifier and
`bazel mod tidy` fight over the empty lines between them.
"""

module(
    name = "theseed",
    version = "1.0",
)

# Common

include("//seed/vendor/bazel:common.MODULE.bazel")

# Go

include("//seed/vendor/go:go.MODULE.bazel")

# Grpc

include("//seed/vendor/grpc:grpc.MODULE.bazel")

# Proto

include("//seed/vendor/proto:proto.MODULE.bazel")

# Apps

## Bazel

include("//seed/vendor/bazel:bazel.MODULE.bazel")
